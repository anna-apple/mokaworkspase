{
  "name": "stream-schedule-supabase",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Single-streamer schedule: password admin, Cloudflare Pages and Supabase",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --env-file=.env scripts/server.mjs",
    "start": "node --env-file=.env scripts/server.mjs",
    "test": "node --test",
    "cf:dev": "wrangler pages dev public",
    "cf:deploy": "wrangler pages deploy public",
    "secrets:generate": "node scripts/generate-secrets.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
